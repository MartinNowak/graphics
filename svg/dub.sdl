name "svg"
description "SVG document engine and command-line renderer."

sourcePaths "."
importPaths "."

// D has no C-style implicit FP contraction; keep a*b+c separate so a
// -march=native (FMA) build renders pixel-identical to a baseline one.
dflags "-ffp-contract=off"

dependency "graphics" path=".."
dependency "std-experimental-xml" version="~>0.1.7"

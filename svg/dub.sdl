name "svg"
description "SVG document engine and command-line renderer."

sourcePaths "."
importPaths "."

// Implicit FP contraction (default, and forced by -march=native/FMA) is
// safe to render with: every pixel-coordinate integerisation snaps its
// grid artifacts first - see graphics.math.snap.

dependency "graphics" path=".."
dependency "std-experimental-xml" version="~>0.1.7"
